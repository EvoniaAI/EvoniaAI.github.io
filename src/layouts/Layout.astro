---
import "../global.css";
import LayoutShell from "../components/layout.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "EvoniaAI · AI First Company",
  description = "EvoniaAI helps global clients build trusted AI Agents and AI Platforms for the AI era.",
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hans">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="EvoniaAI" />
    <meta name="keywords" content="EvoniaAI, 灵栈平云, AI Agent, AI Platform, AI 咨询, AI First, AI 生产力, AI consulting" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="seo" />
    <title>{title}</title>
  </head>
  <body>
    <LayoutShell>
      <slot />
    </LayoutShell>
  </body>
</html>
