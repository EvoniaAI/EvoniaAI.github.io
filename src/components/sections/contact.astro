---
import { contactChannels } from "../../constants";
---

<section id="contact" class="mx-auto w-full max-w-6xl px-4 py-[clamp(4rem,8vw,6rem)]">
  <div
    class="grid items-start gap-10 rounded-panel border border-border p-[clamp(1.75rem,5vw,3.5rem)] shadow-card bg-contact-card min-[900px]:grid-cols-[0.9fr_1.1fr]"
  >
    <div>
      <p class="text-[0.8rem] font-bold uppercase tracking-[0.08em] text-accent-strong">Contact</p>
      <h2 class="mt-3 max-w-[48rem] text-[clamp(2.125rem,4.8vw,3.5rem)] font-bold leading-[1.12] tracking-[-0.01em] text-text-strong">
        让 AI 成为你的下一层能力。
      </h2>
      <p class="mt-5 max-w-[42rem] text-[1.05rem] leading-[1.75] text-text-muted">
        写下你的目标、现有系统和想解决的问题。我们会从信任、交付和长期能力建设的角度开始。
      </p>
    </div>
    <div class="grid gap-4">
      {contactChannels.map((c) => (
        <a
          class="group flex flex-col gap-2 rounded-2xl border border-border bg-surface-strong/94 px-6 py-5 transition duration-200 hover:-translate-y-0.5 hover:border-border-hover hover:bg-surface-strong hover:shadow-card hover:no-underline"
          href={c.href}
          target={c.href.startsWith("http") ? "_blank" : undefined}
          rel="noreferrer"
        >
          <div class="flex items-center justify-between">
            <span class="text-[0.6875rem] font-bold uppercase tracking-[0.08em] text-accent-strong">{c.label}</span>
            <span aria-hidden="true" class="text-base text-text-soft transition duration-200 group-hover:translate-x-1 group-hover:text-accent-strong">→</span>
          </div>
          <p class="break-all font-mono text-base font-semibold text-text-strong">{c.value}</p>
          <p class="text-sm leading-[1.6] text-text-muted">{c.hint}</p>
        </a>
      ))}
    </div>
  </div>
</section>
