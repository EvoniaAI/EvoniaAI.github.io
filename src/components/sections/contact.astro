---
import { GitFork, Mail, UserRound } from "@lucide/astro";
import { contactChannels } from "../../constants";

const iconFor: Record<string, typeof Mail> = {
  Email: Mail,
  Founder: UserRound,
  GitHub: GitFork,
};
---

<section id="contact" class="mx-auto w-full max-w-2xl px-4 py-20 text-center flex flex-col items-center">
  <h2 class="flex items-center justify-center gap-2 text-sm uppercase tracking-wider text-text-soft">
    <Mail aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
    <span>Contact</span>
  </h2>
  <h3 class="mt-4 text-2xl font-light text-text-strong md:text-3xl">
    让 AI 成为你的下一层能力。
  </h3>
  <p class="mx-auto mt-4 max-w-md leading-relaxed text-text-muted">
    写下你的目标、现有系统和想解决的问题。我们会从信任、交付和长期能力建设的角度开始。
  </p>

  <div class="mx-auto mt-10 grid max-w-xl gap-3 sm:grid-cols-3">
    {contactChannels.map((c) => {
      const Icon = iconFor[c.label] ?? Mail;
      return (
        <a
          href={c.href}
          target={c.href.startsWith("http") ? "_blank" : undefined}
          rel="noreferrer"
          class="group flex flex-col items-center gap-1 rounded-2xl border border-border bg-surface p-4 text-sm transition hover:border-accent hover:no-underline"
        >
          <span class="flex items-center gap-1.5 text-text-strong transition-colors group-hover:text-accent">
            <Icon aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
            <span>{c.label}</span>
          </span>
          <span class="truncate text-xs text-text-muted">{c.value}</span>
        </a>
      );
    })}
  </div>
</section>
