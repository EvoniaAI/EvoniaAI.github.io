---
import { ArrowRight, GitFork, Globe, Mail } from "@lucide/astro";
import { contactEmail } from "../../constants";
---

<section
  id="top"
  class="mx-auto flex min-h-[calc(100vh-5rem)] max-w-2xl flex-col items-center justify-center gap-8 px-4 py-20 text-center"
>
  <img
    src="/logo.svg"
    alt="EvoniaAI logo"
    class="h-24 w-24 rounded-2xl border-2 border-accent bg-white"
  />

  <div class="space-y-3">
    <h1 class="text-3xl font-light text-text-strong md:text-4xl">
      EvoniaAI · 灵栈平云
    </h1>
    <p class="text-lg text-text-muted">
      AI First Company · Trust · Global · Dignity
    </p>
  </div>

  <p class="max-w-md leading-relaxed text-text-muted">
    EvoniaAI 帮助全球客户构建世界级 AI Agents 与 AI Platforms，把先进技术落到可运行、可信任、可持续演进的业务系统里。
  </p>

  <div class="flex flex-wrap justify-center gap-6 text-sm">
    <a
      href={`mailto:${contactEmail}`}
      class="flex items-center gap-1.5 text-text-muted transition-colors hover:text-accent"
    >
      <Mail aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
      <span>Email</span>
    </a>
    <a
      href="https://github.com/EvoniaAI"
      target="_blank"
      rel="noreferrer"
      class="flex items-center gap-1.5 text-text-muted transition-colors hover:text-accent"
    >
      <GitFork aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
      <span>GitHub</span>
    </a>
    <a
      href="https://annatarhe.com"
      target="_blank"
      rel="noreferrer"
      class="flex items-center gap-1.5 text-text-muted transition-colors hover:text-accent"
    >
      <Globe aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
      <span>Founder</span>
    </a>
    <a
      href="#projects"
      class="flex items-center gap-1.5 text-text-muted transition-colors hover:text-accent"
    >
      <span>查看公开项目</span>
      <ArrowRight aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
    </a>
  </div>
</section>
