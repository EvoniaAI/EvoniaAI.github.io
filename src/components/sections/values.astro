---
import { Compass, Globe, HeartHandshake, ShieldCheck } from "@lucide/astro";
import { principles } from "../../constants";

const iconFor: Record<string, typeof ShieldCheck> = {
  "Trust first": ShieldCheck,
  "Global vision": Globe,
  "Technology with dignity": HeartHandshake,
};
---

<section id="values" class="mx-auto w-full max-w-5xl px-4 py-20">
  <div class="text-center">
    <h2 class="flex items-center justify-center gap-2 text-sm uppercase tracking-wider text-text-soft">
      <Compass aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
      <span>Our Values</span>
    </h2>
    <h3 class="mt-4 text-2xl font-light text-text-strong md:text-3xl">
      以信任为起点，让 AI 成为组织能力。
    </h3>
    <p class="mx-auto mt-4 max-w-md leading-relaxed text-text-muted">
      三条原则贯穿我们所有的工作：从前期判断、系统设计到最终交付。它们不是口号，而是我们会被客观检验的承诺。
    </p>
  </div>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {principles.map((item) => {
      const Icon = iconFor[item.en] ?? ShieldCheck;
      return (
        <article class="rounded-2xl border border-border bg-surface p-6">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-accent-soft text-accent">
            <Icon aria-hidden="true" class="h-5 w-5" stroke-width={1.75} />
          </div>
          <p class="mt-5 text-xs uppercase tracking-wider text-accent">{item.en}</p>
          <h4 class="mt-2 text-lg font-light text-text-strong">{item.title}</h4>
          <p class="mt-3 text-sm leading-relaxed text-text-muted">{item.text}</p>
        </article>
      );
    })}
  </div>
</section>
