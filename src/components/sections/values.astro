---
import { ShieldCheck } from "@lucide/astro";
import { principles } from "../../constants";
---

<section id="values" class="mx-auto w-full max-w-2xl px-4 py-20">
  <div class="text-center">
    <h2 class="flex items-center justify-center gap-2 text-sm uppercase tracking-wider text-text-soft">
      <ShieldCheck aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
      <span>Our Values</span>
    </h2>
    <h3 class="mt-4 text-2xl font-light text-text-strong md:text-3xl">
      以信任为起点，让 AI 成为组织能力。
    </h3>
    <p class="mx-auto mt-4 max-w-md leading-relaxed text-text-muted">
      三条原则贯穿我们所有的工作：从前期判断、系统设计到最终交付。它们不是口号，而是我们会被客观检验的承诺。
    </p>
  </div>

  <div class="mt-12 space-y-10">
    {principles.map((item) => (
      <article class="space-y-2">
        <p class="text-xs uppercase tracking-wider text-accent">{item.en}</p>
        <h4 class="text-xl font-light text-text-strong">{item.title}</h4>
        <p class="leading-relaxed text-text-muted">{item.text}</p>
      </article>
    ))}
  </div>
</section>
