---
import { FolderGit2 } from "@lucide/astro";
import { projects } from "../../constants";
---

<section id="projects" class="mx-auto w-full max-w-2xl px-4 py-20">
  <div class="text-center">
    <h2 class="flex items-center justify-center gap-2 text-sm uppercase tracking-wider text-text-soft">
      <FolderGit2 aria-hidden="true" class="h-4 w-4" stroke-width={1.75} />
      <span>Public Projects</span>
    </h2>
    <h3 class="mt-4 text-2xl font-light text-text-strong md:text-3xl">
      我们做过的事，是最清晰的自我介绍。
    </h3>
    <p class="mx-auto mt-4 max-w-md leading-relaxed text-text-muted">
      面向开发者、技术内容创作者和摄影师的公开项目，覆盖工具、内容和平台三种形态。
    </p>
  </div>

  <div class="mt-12 grid gap-8 md:grid-cols-2">
    {projects.map((project) => (
      <a
        href={project.url}
        target="_blank"
        rel="noreferrer"
        class="group block space-y-2 hover:no-underline"
      >
        <div class="flex items-baseline justify-between gap-3">
          <h4 class="text-lg text-text-strong transition-colors group-hover:text-accent">
            {project.title}
          </h4>
          <span class="shrink-0 text-xs text-text-soft">{project.tagline}</span>
        </div>
        <p class="text-sm leading-relaxed text-text-muted">{project.summary}</p>
      </a>
    ))}
  </div>
</section>
