---
import { contactEmail } from "../constants";

const currentPath = Astro.url.pathname;
const prefix = currentPath === "/" ? "" : "/";
const navLinks = [
  { href: `${prefix}#values`, label: "价值观" },
  { href: `${prefix}#projects`, label: "项目" },
  { href: `${prefix}#contact`, label: "联系" },
];
---

<header class="sticky top-0 z-30 w-full px-4 pt-3">
  <div class="mx-auto flex h-14 w-full max-w-6xl items-center justify-between rounded-2xl border border-border bg-surface-blur px-4 shadow-sm backdrop-blur-xl md:px-5">
    <a href="/" class="flex min-w-0 items-center gap-3 hover:no-underline" aria-label="EvoniaAI home">
      <img src="/logo.svg" alt="" class="h-8 w-8 rounded-lg bg-white" />
      <span class="truncate text-sm font-semibold tracking-tight text-text-strong sm:text-base">
        EvoniaAI · 灵栈平云
      </span>
    </a>

    <div class="max-md:hidden flex items-center gap-3">
      <nav class="flex items-center gap-1" aria-label="Primary navigation">
        {navLinks.map((link) => (
          <a class="rounded-full px-4 py-2 text-sm font-medium text-text-muted transition-colors duration-200 hover:bg-surface hover:text-text-strong hover:no-underline" href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>
      <a class="inline-flex rounded-full bg-text-strong px-4 py-2 text-sm font-semibold text-text-on-strong transition-colors duration-200 hover:bg-text-strong-hover hover:no-underline" href={`mailto:${contactEmail}`}>
        启动合作
      </a>
    </div>

    <details class="md:hidden group relative">
      <summary class="cursor-pointer list-none rounded-full border border-border px-3 py-2 text-sm font-semibold text-text-strong transition-colors duration-200 hover:bg-surface">
        菜单
      </summary>
      <div class="absolute right-0 mt-2 w-52 rounded-2xl border border-border bg-surface-strong p-2 shadow-xl">
        <nav class="flex flex-col gap-1 text-sm">
          {navLinks.map((link) => (
            <a href={link.href} class="rounded-xl px-3 py-2 text-text-muted transition-colors duration-200 hover:bg-surface hover:text-text-strong hover:no-underline">
              {link.label}
            </a>
          ))}
          <a href={`mailto:${contactEmail}`} class="rounded-xl px-3 py-2 font-semibold text-text-strong transition-colors duration-200 hover:bg-surface hover:no-underline">
            启动合作
          </a>
        </nav>
      </div>
    </details>
  </div>
</header>
