---
const currentPath = Astro.url.pathname;
const prefix = currentPath === "/" ? "" : "/";
const navLinks = [
  { href: `${prefix}#services`, label: "服务" },
  { href: `${prefix}#values`, label: "价值观" },
  { href: `${prefix}#projects`, label: "项目" },
  { href: `${prefix}#contact`, label: "联系" },
];
---

<header class="fixed inset-x-0 top-0 z-50 bg-bg/60 backdrop-blur-sm">
  <nav class="mx-auto max-w-2xl px-4 py-6">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="text-lg font-light text-text-strong transition-colors hover:text-accent"
        aria-label="EvoniaAI home"
      >
        EvoniaAI · 灵栈平云
      </a>

      <div class="hidden items-center gap-8 text-sm md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-text-muted transition-colors hover:text-accent"
          >
            {link.label}
          </a>
        ))}
      </div>

      <details class="relative md:hidden">
        <summary
          class="cursor-pointer text-sm text-text-muted transition-colors hover:text-accent"
        >
          菜单
        </summary>
        <div class="absolute right-0 mt-3 w-40 rounded-lg border border-border bg-surface p-2 shadow-sm">
          <div class="flex flex-col gap-1 text-sm">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class="rounded px-3 py-2 text-text-muted transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>
