---
import { GitFork, Globe, Mail } from "@lucide/astro";
import { contactChannels } from "../constants";

const iconFor: Record<string, typeof Mail> = {
  Email: Mail,
  Founder: Globe,
  GitHub: GitFork,
};

const currentYear = new Date().getFullYear();
---

<footer class="mt-32 pb-16">
  <div class="mx-auto max-w-2xl px-4">
    <div class="space-y-8 border-t border-border pt-8">
      <div class="flex justify-center gap-8">
        {contactChannels.map((c) => {
          const Icon = iconFor[c.label] ?? Mail;
          return (
            <a
              href={c.href}
              target={c.href.startsWith("http") ? "_blank" : undefined}
              rel="noreferrer"
              aria-label={c.label}
              class="text-text-soft transition-colors hover:text-accent"
            >
              <Icon aria-hidden="true" class="h-[18px] w-[18px]" stroke-width={1.75} />
            </a>
          );
        })}
      </div>

      <div class="space-y-2 text-center">
        <p class="text-sm text-text-soft">
          © {currentYear} EvoniaAI · 灵栈平云
        </p>
        <p class="text-xs text-text-soft">
          Trust first. AI first. Build with dignity.
        </p>
      </div>
    </div>
  </div>
</footer>
