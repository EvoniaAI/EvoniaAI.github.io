---
import { contactChannels } from "../constants";
---

<footer class="border-t border-[var(--border)] px-4 py-10">
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 text-sm text-[var(--text-muted)] md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-semibold text-[var(--text-strong)]">EvoniaAI · 灵栈平云</p>
      <p class="mt-2">Trust first. AI first. Build with dignity.</p>
    </div>
    <nav class="flex flex-wrap gap-4" aria-label="Footer links">
      {contactChannels.map((item) => (
        <a href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer" class="hover:text-[var(--text-strong)]">
          {item.label}
        </a>
      ))}
    </nav>
  </div>
  <p class="mx-auto mt-8 max-w-6xl text-xs text-[var(--text-soft)]">
    © {new Date().getFullYear()} EvoniaAI. All rights reserved.
  </p>
</footer>
