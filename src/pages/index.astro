---
import Layout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import Hero from "../components/sections/hero.astro";
import Values from "../components/sections/values.astro";
import Projects from "../components/sections/projects.astro";
import Contact from "../components/sections/contact.astro";
import { contactEmail } from "../constants";

const description =
  "EvoniaAI 是一家 AI First 公司，帮助全球客户构建世界级 AI Agents 与 AI Platforms，让团队在 AI 时代获得更强生产力与能力。";
---

<Layout title="EvoniaAI · AI First Company" description={description}>
  <SEOTags
    slot="seo"
    title="EvoniaAI · AI First Company"
    description={description}
    urlPath="/"
    image="/logo.svg"
  >
    <script
      slot="jsonld"
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "EvoniaAI",
        alternateName: "灵栈平云",
        description,
        url: Astro.site,
        founder: {
          "@type": "Person",
          name: "AnnatarHe",
          url: "https://annatarhe.com",
        },
        email: contactEmail,
      })}
    />
  </SEOTags>

  <Hero />
  <Values />
  <Projects />
  <Contact />
</Layout>
