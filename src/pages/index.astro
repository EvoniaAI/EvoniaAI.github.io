---
import Layout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import { contactEmail, principles, projects, services } from "../constants";

const description =
  "EvoniaAI 是一家 AI First 公司，帮助全球客户构建世界级 AI Agents 与 AI Platforms，让团队在 AI 时代获得更强生产力与能力。";
---

<Layout title="EvoniaAI · AI First Company" description={description}>
  <SEOTags
    slot="seo"
    title="EvoniaAI · AI First Company"
    description={description}
    urlPath="/"
    image="/logo.svg"
  >
    <script
      slot="jsonld"
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "EvoniaAI",
        alternateName: "灵栈平云",
        description,
        url: Astro.site,
        founder: {
          "@type": "Person",
          name: "AnnatarHe",
          url: "https://annatarhe.com",
        },
        email: contactEmail,
      })}
    />
  </SEOTags>

  <section class="hero-section">
    <div class="mx-auto grid min-h-[calc(100vh-5rem)] max-w-6xl items-center gap-12 px-4 py-20 md:grid-cols-[1.1fr_0.9fr] md:py-28">
      <div>
        <p class="eyebrow">AI First Company · 灵栈平云</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-semibold leading-tight text-[var(--text-strong)] md:text-7xl">
          信任优先，构建 AI 时代的真实能力。
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--text-muted)] md:text-xl">
          EvoniaAI 帮助全球客户构建世界级 AI Agents 与 AI Platforms，把先进技术落到可运行、可信任、可持续演进的业务系统里。
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="button-primary" href={`mailto:${contactEmail}`}>启动合作</a>
          <a class="button-secondary" href="#projects">查看公开项目</a>
        </div>
      </div>

      <div class="hero-panel">
        <img src="/logo.svg" alt="EvoniaAI logo" class="h-24 w-24 rounded-3xl bg-white shadow-sm" />
        <p class="mt-8 text-sm font-semibold text-[var(--accent-strong)]">Trust · Global · Dignity</p>
        <h2 class="mt-4 text-3xl font-semibold text-[var(--text-strong)]">我们相信技术与尊严可以让世界更好。</h2>
        <p class="mt-4 leading-7 text-[var(--text-muted)]">
          AI 不应该只带来更快的自动化，也应该带来更清晰的责任、更好的协作，以及更值得信任的产品体验。
        </p>
      </div>
    </div>
  </section>

  <section id="mission" class="section-shell">
    <div class="section-heading">
      <p class="eyebrow">Mission</p>
      <h2 class="section-title">以信任为起点，让 AI 成为组织能力。</h2>
      <p class="section-copy">
        我们和创始人、产品团队、工程团队一起工作，把 AI 从演示样例推进到可被客户依赖的产品和平台。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {principles.map((item) => (
        <article class="quiet-card">
          <h3 class="text-xl font-semibold text-[var(--text-strong)]">{item.title}</h3>
          <p class="mt-4 leading-7 text-[var(--text-muted)]">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="services" class="section-shell">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="eyebrow">What We Build</p>
        <h2 class="section-title">从 Agent 到 Platform，交付能被使用的 AI 系统。</h2>
        <p class="section-copy mt-5">
          我们关注生产系统，而不是一次性 demo。每个项目都围绕业务目标、数据边界、工具集成、用户体验和长期维护展开。
        </p>
      </div>
      <div class="grid gap-4">
        {services.map((service) => (
          <article class="service-row">
            <div>
              <h3 class="text-2xl font-semibold text-[var(--text-strong)]">{service.title}</h3>
              <p class="mt-1 text-sm font-medium text-[var(--accent-strong)]">{service.tagline}</p>
            </div>
            <p class="leading-7 text-[var(--text-muted)]">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="projects" class="section-shell">
    <div class="section-heading">
      <p class="eyebrow">Public Projects</p>
      <h2 class="section-title">公开项目，是我们对未来工作方式的持续实践。</h2>
      <p class="section-copy">
        这些产品覆盖开发者、技术内容和摄影工作流，也展示了 EvoniaAI 对 AI 时代软件形态的判断。
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {projects.map((project) => (
        <a class="project-card" href={project.url} target="_blank" rel="noreferrer">
          <div class="flex items-center gap-4">
            <span class="project-logo-wrap">
              {project.darkLogo ? (
                <>
                  <img src={project.logo} alt={`${project.title} logo`} class="h-10 w-10 dark:hidden" />
                  <img src={project.darkLogo} alt={`${project.title} logo`} class="hidden h-10 w-10 dark:block" />
                </>
              ) : (
                <img src={project.logo} alt={`${project.title} logo`} class="h-10 w-10" />
              )}
            </span>
            <div>
              <h3 class="text-xl font-semibold text-[var(--text-strong)]">{project.title}</h3>
              <p class="text-sm text-[var(--accent-strong)]">{project.tagline}</p>
            </div>
          </div>
          <p class="mt-6 leading-7 text-[var(--text-muted)]">{project.summary}</p>
          <span class="mt-8 inline-flex text-sm font-semibold text-[var(--text-strong)]">访问项目</span>
        </a>
      ))}
    </div>
  </section>

  <section id="founder" class="section-shell">
    <div class="founder-band">
      <div>
        <p class="eyebrow">Founder</p>
        <h2 class="section-title">找到创始人，开始一次严肃的 AI 产品讨论。</h2>
        <p class="section-copy mt-5">
          如果你正在思考 Agent、AI 平台、研发效率或新产品形态，可以从一个清晰的问题开始。我们会一起判断什么值得做，如何做，以及怎样交付到真实用户手里。
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a class="button-primary" href={`mailto:${contactEmail}`}>联系 EvoniaAI</a>
        <a class="button-secondary" href="https://annatarhe.com" target="_blank" rel="noreferrer">访问 annatarhe.com</a>
      </div>
    </div>
  </section>

  <section id="contact" class="section-shell pb-20">
    <div class="contact-card">
      <p class="eyebrow">Contact</p>
      <h2 class="mt-4 text-3xl font-semibold text-[var(--text-strong)] md:text-5xl">让 AI 成为你的下一层能力。</h2>
      <p class="mt-5 max-w-2xl leading-8 text-[var(--text-muted)]">
        写下你的目标、现有系统和想解决的问题。我们会从信任、交付和长期能力建设的角度开始。
      </p>
      <a class="mt-8 inline-flex text-lg font-semibold text-[var(--text-strong)] hover:text-[var(--accent-strong)]" href={`mailto:${contactEmail}`}>
        {contactEmail}
      </a>
    </div>
  </section>
</Layout>
