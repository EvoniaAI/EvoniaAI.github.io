---
import Layout from "../layouts/Layout.astro";
import SEOTags from "../components/seo/seo-tags.astro";
import { contactChannels, contactEmail, principles, projects } from "../constants";

const description =
  "EvoniaAI 是一家 AI First 公司，帮助全球客户构建世界级 AI Agents 与 AI Platforms，让团队在 AI 时代获得更强生产力与能力。";
---

<Layout title="EvoniaAI · AI First Company" description={description}>
  <SEOTags
    slot="seo"
    title="EvoniaAI · AI First Company"
    description={description}
    urlPath="/"
    image="/logo.svg"
  >
    <script
      slot="jsonld"
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "EvoniaAI",
        alternateName: "灵栈平云",
        description,
        url: Astro.site,
        founder: {
          "@type": "Person",
          name: "AnnatarHe",
          url: "https://annatarhe.com",
        },
        email: contactEmail,
      })}
    />
  </SEOTags>

  <section class="hero-section" id="top">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 md:grid-cols-[1.1fr_0.9fr] md:py-28">
      <div>
        <p class="eyebrow">AI First Company · 灵栈平云</p>
        <h1 class="mt-5 max-w-4xl text-5xl font-bold leading-[1.08] tracking-tight text-[var(--text-strong)] md:text-7xl">
          信任优先，<br />构建 AI 时代的<br />真实能力。
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--text-muted)] md:text-xl">
          EvoniaAI 帮助全球客户构建世界级 AI Agents 与 AI Platforms，把先进技术落到可运行、可信任、可持续演进的业务系统里。
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="button-primary" href="#contact">启动合作</a>
          <a class="button-secondary" href="#projects">查看公开项目</a>
        </div>
        <dl class="hero-marks">
          <div><dt>Trust</dt><dd>信任优先</dd></div>
          <div><dt>Global</dt><dd>全球视野</dd></div>
          <div><dt>Dignity</dt><dd>技术与尊严</dd></div>
        </dl>
      </div>

      <div class="hero-panel">
        <div class="hero-logo-row">
          <img src="/logo.svg" alt="EvoniaAI logo" class="h-22 w-22 rounded-3xl bg-white shadow-sm" style="width:5.5rem;height:5.5rem;" />
          <span class="hero-chip">AI First</span>
        </div>
        <p class="mt-8 text-[13px] font-bold text-[var(--accent-strong)]">Trust · Global · Dignity</p>
        <h2 class="mt-3.5 text-2xl font-bold leading-tight text-[var(--text-strong)] md:text-[1.75rem]">
          我们相信技术与尊严可以让世界更好。
        </h2>
        <p class="mt-4 leading-7 text-[var(--text-muted)]">
          AI 不应该只带来更快的自动化，也应该带来更清晰的责任、更好的协作，以及更值得信任的产品体验。
        </p>
      </div>
    </div>
  </section>

  <section id="values" class="section-shell">
    <div class="section-heading">
      <p class="eyebrow">Our Values</p>
      <h2 class="section-title">以信任为起点，让 AI 成为组织能力。</h2>
      <p class="section-copy mt-4">
        三条原则贯穿我们所有的工作：从前期判断、系统设计到最终交付。它们不是口号，而是我们会被客观检验的承诺。
      </p>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {principles.map((item, i) => (
        <article class="value-card">
          <span class="value-num">0{i + 1}</span>
          <h3 class="value-title">{item.title}</h3>
          <p class="value-en">{item.en}</p>
          <p class="value-body">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="section-shell">
    <div class="section-heading">
      <p class="eyebrow">Public Projects</p>
      <h2 class="section-title">我们做过的事，是最清晰的自我介绍。</h2>
      <p class="section-copy mt-4">
        三个公开项目分别面向开发者、技术内容创作者和摄影师，覆盖工具、内容和平台三种形态，也展示了 EvoniaAI 对 AI 时代软件的判断。
      </p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {projects.map((project) => (
        <a class="project-card" href={project.url} target="_blank" rel="noreferrer">
          <div class="flex items-center gap-4">
            <span class="project-logo-wrap">
              {project.darkLogo ? (
                <>
                  <img src={project.logo} alt={`${project.title} logo`} class="h-10 w-10 dark:hidden" />
                  <img src={project.darkLogo} alt={`${project.title} logo`} class="hidden h-10 w-10 dark:block" />
                </>
              ) : (
                <img src={project.logo} alt={`${project.title} logo`} class="h-10 w-10" />
              )}
            </span>
            <div>
              <h3 class="text-xl font-bold text-[var(--text-strong)]">{project.title}</h3>
              <p class="project-tagline">{project.tagline}</p>
            </div>
          </div>
          <p class="mt-5 leading-7 text-[var(--text-muted)]">{project.summary}</p>
          <span class="project-cta">访问项目 ·</span>
        </a>
      ))}
    </div>
  </section>

  <section id="contact" class="section-shell pb-24">
    <div class="contact-card">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 class="mt-3.5 text-3xl font-bold leading-tight tracking-tight text-[var(--text-strong)] md:text-[2.75rem]">
          让 AI 成为你的下一层能力。
        </h2>
        <p class="mt-4 max-w-xl leading-8 text-[var(--text-muted)]">
          写下你的目标、现有系统和想解决的问题。我们会从信任、交付和长期能力建设的角度开始。
        </p>
      </div>
      <div class="contact-channels">
        {contactChannels.map((c) => (
          <a
            class="channel-card"
            href={c.href}
            target={c.href.startsWith("http") ? "_blank" : undefined}
            rel="noreferrer"
          >
            <div class="channel-top">
              <span class="channel-label">{c.label}</span>
              <span class="channel-arrow" aria-hidden="true">→</span>
            </div>
            <p class="channel-value">{c.value}</p>
            <p class="channel-hint">{c.hint}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
